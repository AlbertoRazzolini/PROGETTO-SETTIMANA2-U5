# Copia questo file in .env (o imposta le stesse variabili nella Run Configuration
# dell'IDE) e valorizza i segreti. .env non va mai committato.

# --- Database (Postgres) ---
DB_URL=jdbc:postgresql://localhost:5432/db-PS2U5
DB_USERNAME=postgres
DB_PASSWORD=

# --- Email (Gmail SMTP) ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=alberto.razzolini@gmail.com

# --- IA (OpenRouter) ---
OPENROUTER_API_KEY=

# --- JWT ---
# Opzionale: application.properties ha gia' un default (lasciato in chiaro
# per comodita' di correzione, progetto didattico). Valorizza solo se vuoi
# sovrascriverlo con un secret tuo.
JWT_SECRET=
JWT_EXPIRATION=604800000

# --- CORS ---
ALLOWED_ORIGIN=http://localhost:5173
